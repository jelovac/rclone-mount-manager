# rclone-mount-manager user configuration.
#
# Default install path:
#   ~/.config/rclone-mount-manager/config
#
# This is a Bash config file. Keep it local and trusted.

MODE=user

# Base directory for mounts without an explicit MOUNT_POINTS override.
ROOT_DIR_PATH="$HOME/mnt/rclone"

# Logs and runtime state.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rclone-mount-manager/logs"
PERSISTENT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rclone-mount-manager"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  STATE_DIR="$XDG_RUNTIME_DIR/rclone-mount-manager"
else
  STATE_DIR="/tmp/rclone-mount-manager-$(id -u)"
fi

# Mount/unmount wait windows.
START_TIMEOUT_SECONDS=20
STOP_TIMEOUT_SECONDS=20

# Independent supervisor health checks and retry backoff.
HEALTH_CHECK_INTERVAL_SECONDS=5
RETRY_DELAYS_SECONDS=(10 30 60 300)
RETRY_RESET_SECONDS=600
SUPERVISOR_RESTART_DELAY_SECONDS=30

# Pre-mount remote availability check.
CONNECTIVITY_CHECK=remote
CONNECTIVITY_RETRIES=12
CONNECTIVITY_INTERVAL_SECONDS=5
CONNECTIVITY_TIMEOUT_SECONDS=15

# Safety defaults.
REQUIRE_EMPTY_MOUNTPOINT=true
ROLLBACK_ON_START_FAILURE=false

# Default options applied to every mount.
#
# These directory-cache values are safe for remotes with and without change
# polling. See docs/configuration.md for backend-specific tuning.
DEFAULT_OPTIONS=(
  --vfs-cache-mode full
  --vfs-cache-max-size 10G
  --vfs-cache-max-age 12h
  --dir-cache-time 5m
  --poll-interval 1m
  --attr-timeout 1s
  --transfers 4
  --multi-thread-streams 4
)

# Add your mounts here.
MOUNTS=(
  # PersonalDrive
)

REMOTES=(
  # [PersonalDrive]="PersonalDrive:"
)

# Optional absolute mount point overrides.
MOUNT_POINTS=(
  # [PersonalDrive]="$HOME/Documents/Cloud"
)

# Optional per-mount rclone options.
MOUNT_OPTIONS=(
  # [PersonalDrive]="--vfs-read-chunk-size 128M"
)
