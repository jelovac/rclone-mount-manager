#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="rclone-mount-manager"
VERSION="0.3.0"

USER_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_NAME/config"
SYSTEM_CONFIG_FILE="/etc/$APP_NAME/config"

CONFIG_FILE="${RMM_CONFIG_FILE:-}"
MODE="${RMM_MODE:-user}"
ROOT_DIR_PATH="${RMM_ROOT_DIR_PATH:-}"
LOG_DIR="${RMM_LOG_DIR:-}"
STATE_DIR="${RMM_STATE_DIR:-}"
PERSISTENT_STATE_DIR="${RMM_PERSISTENT_STATE_DIR:-}"
START_TIMEOUT_SECONDS="${RMM_START_TIMEOUT_SECONDS:-20}"
STOP_TIMEOUT_SECONDS="${RMM_STOP_TIMEOUT_SECONDS:-20}"
CONNECTIVITY_CHECK="${RMM_CONNECTIVITY_CHECK:-remote}"
CONNECTIVITY_RETRIES="${RMM_CONNECTIVITY_RETRIES:-12}"
CONNECTIVITY_INTERVAL_SECONDS="${RMM_CONNECTIVITY_INTERVAL_SECONDS:-5}"
CONNECTIVITY_TIMEOUT_SECONDS="${RMM_CONNECTIVITY_TIMEOUT_SECONDS:-15}"
REQUIRE_EMPTY_MOUNTPOINT="${RMM_REQUIRE_EMPTY_MOUNTPOINT:-true}"
ROLLBACK_ON_START_FAILURE="${RMM_ROLLBACK_ON_START_FAILURE:-false}"
HEALTH_CHECK_INTERVAL_SECONDS="${RMM_HEALTH_CHECK_INTERVAL_SECONDS:-5}"
RETRY_RESET_SECONDS="${RMM_RETRY_RESET_SECONDS:-600}"
SUPERVISOR_RESTART_DELAY_SECONDS="${RMM_SUPERVISOR_RESTART_DELAY_SECONDS:-30}"

RETRY_DELAYS_SECONDS=(10 30 60 300)

DEFAULT_OPTIONS=(
  --vfs-cache-mode full
  --vfs-cache-max-size 10G
  --vfs-cache-max-age 12h
  --dir-cache-time 72h
  --poll-interval 30s
  --attr-timeout 1s
  --transfers 4
  --multi-thread-streams 4
)

MOUNTS=()
STARTED_MOUNTS=()
declare -A REMOTES=()
declare -A MOUNT_POINTS=()
declare -A MOUNT_OPTIONS=()
declare -A SUPERVISOR_PIDS=()
declare -A SUPERVISOR_RESTART_AT=()

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<EOF
$APP_NAME $VERSION

Usage:
  $APP_NAME <command>

Commands:
  start          Mount configured remotes using rclone --daemon.
  stop           Gracefully unmount configured remotes.
  restart        Stop and start configured remotes.
  status [--json]
                 Show configured mount status.
  mount ACTION NAME
                 Control one supervised mount. ACTION is pause, resume,
                 restart, or retry.
  run            Foreground supervised mode for systemd.
  doctor         Check dependencies, config, remotes, and mount paths.
  print-config   Print resolved runtime settings.
  help           Show this help.

Configuration:
  User default:   $USER_CONFIG_FILE
  System default: $SYSTEM_CONFIG_FILE
  Override:       RMM_CONFIG_FILE=/path/to/config
EOF
}

is_true() {
  case "${1,,}" in
    1 | yes | true | on) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_absolute_path() {
  local path="$1"
  local dir
  local base

  if [[ "$path" == /* ]]; then
    printf '%s\n' "$path"
    return 0
  fi

  dir="$(cd -- "$(dirname -- "$path")" >/dev/null 2>&1 && pwd -P)" || return 1
  base="$(basename -- "$path")"
  printf '%s/%s\n' "$dir" "$base"
}

select_config_file() {
  if [[ -n "$CONFIG_FILE" ]]; then
    CONFIG_FILE="$(resolve_absolute_path "$CONFIG_FILE")" || die "Cannot resolve config file path: $CONFIG_FILE"
    [[ -f "$CONFIG_FILE" ]] || die "Config file does not exist: $CONFIG_FILE"
    return 0
  fi

  if [[ -f "$USER_CONFIG_FILE" ]]; then
    CONFIG_FILE="$USER_CONFIG_FILE"
    return 0
  fi

  if [[ "$(id -u)" == "0" && -f "$SYSTEM_CONFIG_FILE" ]]; then
    CONFIG_FILE="$SYSTEM_CONFIG_FILE"
    return 0
  fi
}

apply_runtime_defaults() {
  case "$MODE" in
    user | system) ;;
    *) die "MODE must be either 'user' or 'system'; got '$MODE'" ;;
  esac

  if [[ -z "$ROOT_DIR_PATH" ]]; then
    if [[ "$MODE" == "system" ]]; then
      ROOT_DIR_PATH="/mnt/rclone"
    else
      ROOT_DIR_PATH="$HOME/mnt/rclone"
    fi
  fi

  if [[ -z "$LOG_DIR" ]]; then
    if [[ "$MODE" == "system" ]]; then
      LOG_DIR="/var/log/$APP_NAME"
    else
      LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$APP_NAME/logs"
    fi
  fi

  if [[ -z "$STATE_DIR" ]]; then
    if [[ "$MODE" == "system" ]]; then
      STATE_DIR="/run/$APP_NAME"
    elif [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
      STATE_DIR="$XDG_RUNTIME_DIR/$APP_NAME"
    else
      STATE_DIR="/tmp/$APP_NAME-$(id -u)"
    fi
  fi

  if [[ -z "$PERSISTENT_STATE_DIR" ]]; then
    if [[ "$MODE" == "system" ]]; then
      PERSISTENT_STATE_DIR="/var/lib/$APP_NAME"
    else
      PERSISTENT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$APP_NAME"
    fi
  fi
}

load_config() {
  select_config_file || true

  if [[ -n "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi

  apply_runtime_defaults
}

validate_config() {
  local mount_name
  local mount_point
  local retry_delay
  declare -A seen_mounts=()
  declare -A seen_mount_points=()

  ((${#MOUNTS[@]} > 0)) || die "No mounts configured. Create/edit a config file first."
  [[ "$START_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "START_TIMEOUT_SECONDS must be a positive integer."
  [[ "$STOP_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "STOP_TIMEOUT_SECONDS must be a positive integer."
  [[ "$HEALTH_CHECK_INTERVAL_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "HEALTH_CHECK_INTERVAL_SECONDS must be a positive integer."
  [[ "$RETRY_RESET_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "RETRY_RESET_SECONDS must be a positive integer."
  [[ "$SUPERVISOR_RESTART_DELAY_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "SUPERVISOR_RESTART_DELAY_SECONDS must be a positive integer."
  ((${#RETRY_DELAYS_SECONDS[@]} > 0)) || die "RETRY_DELAYS_SECONDS must contain at least one delay."

  case "$CONNECTIVITY_CHECK" in
    off) ;;
    remote)
      [[ "$CONNECTIVITY_RETRIES" =~ ^[1-9][0-9]*$ ]] || die "CONNECTIVITY_RETRIES must be a positive integer."
      [[ "$CONNECTIVITY_INTERVAL_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "CONNECTIVITY_INTERVAL_SECONDS must be a positive integer."
      [[ "$CONNECTIVITY_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || die "CONNECTIVITY_TIMEOUT_SECONDS must be a positive integer."
      ;;
    *) die "Unsupported CONNECTIVITY_CHECK value: $CONNECTIVITY_CHECK" ;;
  esac

  for retry_delay in "${RETRY_DELAYS_SECONDS[@]}"; do
    [[ "$retry_delay" =~ ^[1-9][0-9]*$ ]] || die "RETRY_DELAYS_SECONDS values must be positive integers."
  done

  for mount_name in "${MOUNTS[@]}"; do
    [[ -n "$mount_name" ]] || die "Mount names must not be empty."
    [[ "$mount_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Invalid mount name '$mount_name'. Use letters, numbers, dots, underscores, and dashes."
    [[ -z "${seen_mounts[$mount_name]:-}" ]] || die "Duplicate mount name: $mount_name"
    seen_mounts[$mount_name]=1
    [[ -n "${REMOTES[$mount_name]:-}" ]] || die "Missing REMOTES[$mount_name]."

    mount_point="$(mount_point_for "$mount_name")"
    [[ "$mount_point" == /* ]] || die "Mount point for $mount_name must be an absolute path: $mount_point"
    [[ -z "${seen_mount_points[$mount_point]:-}" ]] || die "Mount point is configured more than once: $mount_point"
    seen_mount_points[$mount_point]="$mount_name"
  done
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not installed or not found in PATH."
}

ensure_requirements_for_start() {
  require_command rclone
  require_command mountpoint
  if [[ "$CONNECTIVITY_CHECK" == "remote" ]]; then
    require_command timeout
  fi
}

ensure_directories() {
  mkdir -p "$ROOT_DIR_PATH" "$LOG_DIR" "$PERSISTENT_STATE_DIR/paused"
  ensure_state_directory
  ensure_private_directory "$PERSISTENT_STATE_DIR/paused"
  mkdir -p "$STATE_DIR/control"
  ensure_private_directory "$STATE_DIR/control"
}

ensure_private_directory() {
  local directory="$1"
  local current_uid
  local directory_owner
  local directory_mode

  current_uid="$(id -u)"
  directory_owner="$(stat -c '%u' "$directory")"
  directory_mode="$(stat -c '%a' "$directory")"

  [[ "$directory_owner" == "$current_uid" ]] || die "Directory is not owned by current user: $directory"

  if ((8#$directory_mode & 8#077)); then
    chmod 0700 "$directory"
  fi
}

ensure_state_directory() {
  local current_uid
  local state_owner
  local state_mode

  current_uid="$(id -u)"

  if [[ -e "$STATE_DIR" && ! -d "$STATE_DIR" ]]; then
    die "State path exists but is not a directory: $STATE_DIR"
  fi

  mkdir -p "$STATE_DIR"

  state_owner="$(stat -c '%u' "$STATE_DIR")"
  state_mode="$(stat -c '%a' "$STATE_DIR")"

  [[ "$state_owner" == "$current_uid" ]] || die "State dir is not owned by current user: $STATE_DIR"

  if ((8#$state_mode & 8#077)); then
    chmod 0700 "$STATE_DIR"
  fi
}

mount_point_for() {
  local mount_name="$1"
  printf '%s\n' "${MOUNT_POINTS[$mount_name]:-$ROOT_DIR_PATH/$mount_name}"
}

log_file_for() {
  local mount_name="$1"
  printf '%s/%s-rclone-mount.log\n' "$LOG_DIR" "$mount_name"
}

pid_file_for() {
  local mount_name="$1"
  printf '%s/%s.pid\n' "$STATE_DIR" "$mount_name"
}

status_file_for() {
  local mount_name="$1"
  printf '%s/%s.status\n' "$STATE_DIR" "$mount_name"
}

pause_file_for() {
  local mount_name="$1"
  printf '%s/paused/%s\n' "$PERSISTENT_STATE_DIR" "$mount_name"
}

control_file_for() {
  local mount_name="$1"
  printf '%s/control/%s.command\n' "$STATE_DIR" "$mount_name"
}

mount_is_paused() {
  local mount_name="$1"
  [[ -f "$(pause_file_for "$mount_name")" ]]
}

mount_is_configured() {
  local requested_name="$1"
  local mount_name

  for mount_name in "${MOUNTS[@]}"; do
    [[ "$mount_name" == "$requested_name" ]] && return 0
  done

  return 1
}

write_mount_state() {
  local mount_name="$1"
  local status="$2"
  local failures="${3:-0}"
  local next_retry="${4:-0}"
  local last_error="${5:-}"
  local status_file
  local temporary_file

  status_file="$(status_file_for "$mount_name")"
  temporary_file="$status_file.tmp.$BASHPID"
  last_error="${last_error//$'\n'/ }"

  {
    printf 'status=%s\n' "$status"
    printf 'failures=%s\n' "$failures"
    printf 'next_retry=%s\n' "$next_retry"
    printf 'last_error=%s\n' "$last_error"
  } >"$temporary_file"
  mv -f "$temporary_file" "$status_file"
}

read_mount_state_field() {
  local mount_name="$1"
  local requested_field="$2"
  local status_file
  local field
  local value

  status_file="$(status_file_for "$mount_name")"
  [[ -r "$status_file" ]] || return 1

  while IFS='=' read -r field value; do
    if [[ "$field" == "$requested_field" ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done <"$status_file"

  return 1
}

json_quote() {
  local value="$1"
  local character
  local escaped=""
  local code
  local index
  local LC_ALL=C

  for ((index = 0; index < ${#value}; index++)); do
    character="${value:index:1}"
    case "$character" in
      '"') escaped+='\"' ;;
      \\) escaped="${escaped}\\\\" ;;
      $'\b') escaped+='\b' ;;
      $'\f') escaped+='\f' ;;
      $'\n') escaped+='\n' ;;
      $'\r') escaped+='\r' ;;
      $'\t') escaped+='\t' ;;
      *)
        printf -v code '%d' "'$character"
        if ((code < 32)); then
          printf -v escaped '%s\\u%04x' "$escaped" "$code"
        else
          escaped+="$character"
        fi
        ;;
    esac
  done

  printf '"%s"' "$escaped"
}

normalized_mount_status() {
  local mount_name="$1"
  local mounted="${2:-}"
  local mount_point
  local state_status

  mount_point="$(mount_point_for "$mount_name")"

  if [[ -z "$mounted" ]]; then
    mounted=false
    mountpoint -q "$mount_point" && mounted=true
  fi

  if [[ "$mounted" == "true" ]]; then
    if mount_is_paused "$mount_name"; then
      printf 'pausing\n'
    else
      printf 'mounted\n'
    fi
    return 0
  fi

  if mount_is_paused "$mount_name"; then
    printf 'paused\n'
    return 0
  fi

  state_status="$(read_mount_state_field "$mount_name" status 2>/dev/null || true)"
  case "$state_status" in
    starting | retrying | failed | stopped | pausing) printf '%s\n' "$state_status" ;;
    *) printf 'not-mounted\n' ;;
  esac
}

directory_has_entries() {
  local dir="$1"
  local entries=()

  shopt -s nullglob dotglob
  entries=("$dir"/*)
  shopt -u nullglob dotglob

  ((${#entries[@]} > 0))
}

validate_mount_point_safe() {
  local mount_name="$1"
  local mount_point="$2"

  mkdir -p "$mount_point"

  if mountpoint -q "$mount_point"; then
    return 0
  fi

  if is_true "$REQUIRE_EMPTY_MOUNTPOINT" && directory_has_entries "$mount_point"; then
    log "Mount point for $mount_name is not empty: $mount_point"
    return 1
  fi
}

recorded_process_matches_mount() {
  local mount_name="$1"
  local pid="$2"
  local remote="${REMOTES[$mount_name]}"
  local mount_point
  local argument
  local found_remote=false
  local found_mount_point=false

  mount_point="$(mount_point_for "$mount_name")"
  [[ "$pid" =~ ^[1-9][0-9]*$ && -r "/proc/$pid/cmdline" ]] || return 1

  while IFS= read -r -d '' argument; do
    [[ "$argument" == "$remote" ]] && found_remote=true
    [[ "$argument" == "$mount_point" ]] && found_mount_point=true
  done <"/proc/$pid/cmdline"

  [[ "$found_remote" == "true" && "$found_mount_point" == "true" ]]
}

recorded_process_is_running() {
  local mount_name="$1"
  local pid_file
  local pid

  pid_file="$(pid_file_for "$mount_name")"
  [[ -r "$pid_file" ]] || return 1
  pid="$(<"$pid_file")"

  kill -0 "$pid" >/dev/null 2>&1 && recorded_process_matches_mount "$mount_name" "$pid"
}

terminate_recorded_process() {
  local mount_name="$1"
  local pid_file
  local pid
  local waited=0

  pid_file="$(pid_file_for "$mount_name")"
  [[ -r "$pid_file" ]] || return 0
  pid="$(<"$pid_file")"

  if kill -0 "$pid" >/dev/null 2>&1; then
    if recorded_process_matches_mount "$mount_name" "$pid"; then
      log "Sending SIGTERM to recorded rclone pid $pid for $mount_name"
      kill "$pid" >/dev/null 2>&1 || true

      while kill -0 "$pid" >/dev/null 2>&1 && ((waited < 5)); do
        sleep 1
        waited=$((waited + 1))
      done

      if kill -0 "$pid" >/dev/null 2>&1; then
        log "Recorded rclone pid $pid did not stop; sending SIGKILL"
        kill -KILL "$pid" >/dev/null 2>&1 || true
      fi
    else
      log "Ignoring stale pid file for $mount_name; pid $pid does not match this mount"
    fi
  fi

  rm -f "$pid_file"
}

check_remote_available() {
  local mount_name="$1"
  local remote="$2"
  local attempt=1

  case "$CONNECTIVITY_CHECK" in
    off) return 0 ;;
    remote) ;;
    *) die "Unsupported CONNECTIVITY_CHECK value: $CONNECTIVITY_CHECK" ;;
  esac

  while ((attempt <= CONNECTIVITY_RETRIES)); do
    log "Checking remote availability for $mount_name ($remote), attempt $attempt/$CONNECTIVITY_RETRIES"

    if timeout "$CONNECTIVITY_TIMEOUT_SECONDS" rclone lsf "$remote" --max-depth 1 --log-level ERROR >/dev/null 2>&1; then
      return 0
    fi

    if ((attempt < CONNECTIVITY_RETRIES)); then
      sleep "$CONNECTIVITY_INTERVAL_SECONDS"
    fi

    attempt=$((attempt + 1))
  done

  log "Remote check failed for $mount_name after $CONNECTIVITY_RETRIES attempts"
  return 1
}

wait_until_mounted() {
  local mount_point="$1"
  local timeout_seconds="$2"
  local pid="${3:-}"
  local waited=0

  while ((waited <= timeout_seconds)); do
    if mountpoint -q "$mount_point"; then
      return 0
    fi
    if [[ -n "$pid" ]] && ! kill -0 "$pid" >/dev/null 2>&1; then
      return 1
    fi
    ((waited < timeout_seconds)) || break
    sleep 1
    waited=$((waited + 1))
  done

  return 1
}

wait_until_unmounted() {
  local mount_point="$1"
  local timeout_seconds="$2"
  local waited=0

  while ((waited <= timeout_seconds)); do
    if ! mountpoint -q "$mount_point"; then
      return 0
    fi
    ((waited < timeout_seconds)) || break
    sleep 1
    waited=$((waited + 1))
  done

  return 1
}

unmount_with_available_tool() {
  local mount_point="$1"
  local mode="${2:-normal}"

  if command -v fusermount3 >/dev/null 2>&1; then
    if [[ "$mode" == "lazy" ]]; then
      fusermount3 -uz "$mount_point"
    else
      fusermount3 -u "$mount_point"
    fi
  elif command -v fusermount >/dev/null 2>&1; then
    if [[ "$mode" == "lazy" ]]; then
      fusermount -uz "$mount_point"
    else
      fusermount -u "$mount_point"
    fi
  else
    umount "$mount_point"
  fi
}

start_one_daemon() {
  local mount_name="$1"
  local remote="${REMOTES[$mount_name]}"
  local mount_point
  local log_file
  local custom_options

  mount_point="$(mount_point_for "$mount_name")"
  log_file="$(log_file_for "$mount_name")"
  custom_options="${MOUNT_OPTIONS[$mount_name]:-}"

  validate_mount_point_safe "$mount_name" "$mount_point" || return 1
  if ! touch "$log_file"; then
    log "Log file is not writable for $mount_name: $log_file"
    return 1
  fi

  if mountpoint -q "$mount_point"; then
    log "$mount_name is already mounted at $mount_point"
    return 0
  fi

  check_remote_available "$mount_name" "$remote" || return 1
  log "Mounting $remote at $mount_point"

  # custom_options is intentionally word-split for simple rclone option pairs.
  # shellcheck disable=SC2086
  if ! rclone mount "$remote" "$mount_point" \
    "${DEFAULT_OPTIONS[@]}" \
    $custom_options \
    --log-file "$log_file" \
    --log-level INFO \
    --daemon; then
    log "rclone mount failed for $mount_name"
    return 1
  fi

  if wait_until_mounted "$mount_point" "$START_TIMEOUT_SECONDS"; then
    log "Mounted $mount_name at $mount_point; logging to $log_file"
    STARTED_MOUNTS+=("$mount_name")
    return 0
  fi

  log "Mount did not become active for $mount_name within ${START_TIMEOUT_SECONDS}s"
  return 1
}

start_one_foreground() {
  local mount_name="$1"
  local remote="${REMOTES[$mount_name]}"
  local mount_point
  local log_file
  local pid_file
  local pid
  local custom_options

  mount_point="$(mount_point_for "$mount_name")"
  log_file="$(log_file_for "$mount_name")"
  pid_file="$(pid_file_for "$mount_name")"
  custom_options="${MOUNT_OPTIONS[$mount_name]:-}"

  validate_mount_point_safe "$mount_name" "$mount_point" || return 1
  if ! touch "$log_file"; then
    log "Log file is not writable for $mount_name: $log_file"
    return 1
  fi

  if mountpoint -q "$mount_point"; then
    if [[ -e "$pid_file" ]] && ! recorded_process_is_running "$mount_name"; then
      rm -f "$pid_file"
    fi
    log "$mount_name is already mounted at $mount_point"
    return 0
  fi

  terminate_recorded_process "$mount_name"

  check_remote_available "$mount_name" "$remote" || return 1
  log "Starting supervised mount $remote at $mount_point"

  # custom_options is intentionally word-split for simple rclone option pairs.
  # shellcheck disable=SC2086
  rclone mount "$remote" "$mount_point" \
    "${DEFAULT_OPTIONS[@]}" \
    $custom_options \
    --log-file "$log_file" \
    --log-level INFO &

  pid="$!"
  printf '%s\n' "$pid" >"$pid_file"

  if wait_until_mounted "$mount_point" "$START_TIMEOUT_SECONDS" "$pid"; then
    log "Mounted $mount_name at $mount_point; rclone pid $pid"
    return 0
  fi

  log "Mount did not become active for $mount_name within ${START_TIMEOUT_SECONDS}s"
  terminate_recorded_process "$mount_name"
  return 1
}

stop_one() {
  local mount_name="$1"
  local mount_point

  mount_point="$(mount_point_for "$mount_name")"

  if ! mountpoint -q "$mount_point"; then
    terminate_recorded_process "$mount_name"
    log "$mount_name is not mounted"
    return 0
  fi

  log "Unmounting $mount_name from $mount_point"

  if ! unmount_with_available_tool "$mount_point" normal; then
    log "Normal unmount failed for $mount_name; waiting before lazy fallback"
  fi

  if wait_until_unmounted "$mount_point" "$STOP_TIMEOUT_SECONDS"; then
    terminate_recorded_process "$mount_name"
    log "Unmounted $mount_name"
    return 0
  fi

  log "$mount_name is still mounted after ${STOP_TIMEOUT_SECONDS}s; trying lazy unmount"
  unmount_with_available_tool "$mount_point" lazy || true

  if wait_until_unmounted "$mount_point" 5; then
    terminate_recorded_process "$mount_name"
    log "Lazy-unmounted $mount_name"
    return 0
  fi

  terminate_recorded_process "$mount_name"

  log "Failed to unmount $mount_name from $mount_point"
  return 1
}

mount_is_healthy() {
  local mount_name="$1"
  local mount_point
  local pid_file

  mount_point="$(mount_point_for "$mount_name")"
  pid_file="$(pid_file_for "$mount_name")"

  mountpoint -q "$mount_point" || return 1
  [[ ! -e "$pid_file" ]] || recorded_process_is_running "$mount_name"
}

mount_failure_reason() {
  local mount_name="$1"
  local mount_point
  local pid_file

  mount_point="$(mount_point_for "$mount_name")"
  pid_file="$(pid_file_for "$mount_name")"

  if ! mountpoint -q "$mount_point"; then
    printf 'mount point is no longer active'
  elif [[ -e "$pid_file" ]] && ! recorded_process_is_running "$mount_name"; then
    printf 'rclone process exited'
  else
    printf 'health check failed'
  fi
}

retry_delay_for_failure() {
  local failure_count="$1"
  local index=$((failure_count - 1))
  local last_index=$((${#RETRY_DELAYS_SECONDS[@]} - 1))

  ((index <= last_index)) || index="$last_index"
  printf '%s\n' "${RETRY_DELAYS_SECONDS[$index]}"
}

supervise_one_mount() {
  local mount_name="$1"
  local failures=0
  local mounted_since=0
  local now
  local retry_delay
  local next_retry
  local last_error

  trap - INT TERM HUP

  while true; do
    write_mount_state "$mount_name" starting "$failures" 0 ""

    if start_one_foreground "$mount_name"; then
      mounted_since="$(date +%s)"
      write_mount_state "$mount_name" mounted "$failures" 0 ""

      while mount_is_healthy "$mount_name"; do
        sleep "$HEALTH_CHECK_INTERVAL_SECONDS"
      done

      now="$(date +%s)"
      if ((now - mounted_since >= RETRY_RESET_SECONDS)); then
        failures=0
      fi

      last_error="$(mount_failure_reason "$mount_name")"
      log "$mount_name failed: $last_error; cleaning up only this mount"
      stop_one "$mount_name" || true
    else
      last_error="start attempt failed"
      log "$mount_name failed to start"
    fi

    failures=$((failures + 1))
    retry_delay="$(retry_delay_for_failure "$failures")"
    next_retry=$(($(date +%s) + retry_delay))
    write_mount_state "$mount_name" retrying "$failures" "$next_retry" "$last_error"
    log "$mount_name will retry in ${retry_delay}s (failure $failures)"
    sleep "$retry_delay"
  done
}

start_mount_supervisor() {
  local mount_name="$1"

  supervise_one_mount "$mount_name" &
  SUPERVISOR_PIDS[$mount_name]="$!"
  unset 'SUPERVISOR_RESTART_AT[$mount_name]'
  log "Started supervisor for $mount_name; pid ${SUPERVISOR_PIDS[$mount_name]}"
}

stop_mount_supervisor() {
  local mount_name="$1"
  local supervisor_pid="${SUPERVISOR_PIDS[$mount_name]:-}"

  if [[ -n "$supervisor_pid" ]]; then
    if kill -0 "$supervisor_pid" >/dev/null 2>&1; then
      kill -TERM "$supervisor_pid" >/dev/null 2>&1 || true
    fi
    wait "$supervisor_pid" 2>/dev/null || true
  fi

  unset 'SUPERVISOR_PIDS[$mount_name]'
  unset 'SUPERVISOR_RESTART_AT[$mount_name]'
}

restart_mount_supervisor() {
  local mount_name="$1"

  log "Restart requested for $mount_name"
  stop_mount_supervisor "$mount_name"
  stop_one "$mount_name" || true
  start_mount_supervisor "$mount_name"
}

set_mount_paused() {
  local mount_name="$1"
  local paused="$2"
  local pause_file
  local temporary_file

  pause_file="$(pause_file_for "$mount_name")"
  if [[ "$paused" == "true" ]]; then
    temporary_file="$pause_file.tmp.$BASHPID"
    printf '%s\n' "$mount_name" >"$temporary_file"
    mv -f "$temporary_file" "$pause_file"
  else
    rm -f "$pause_file"
  fi
}

queue_mount_control() {
  local mount_name="$1"
  local action="$2"
  local control_file
  local temporary_file

  control_file="$(control_file_for "$mount_name")"
  temporary_file="$control_file.tmp.$BASHPID"
  printf '%s\n' "$action" >"$temporary_file"
  mv -f "$temporary_file" "$control_file"
}

request_mount_control() {
  local action="$1"
  local mount_name="$2"

  mount_is_configured "$mount_name" || die "Unknown mount: $mount_name"
  ensure_directories

  case "$action" in
    pause)
      set_mount_paused "$mount_name" true
      write_mount_state "$mount_name" pausing 0 0 ""
      ;;
    resume)
      set_mount_paused "$mount_name" false
      ;;
    restart | retry)
      mount_is_paused "$mount_name" && die "$mount_name is paused; resume it first."
      ;;
    *) die "Unsupported mount action: $action. Use pause, resume, restart, or retry." ;;
  esac

  queue_mount_control "$mount_name" "$action"
  printf 'Requested %s for %s.\n' "$action" "$mount_name"
}

process_mount_control() {
  local mount_name="$1"
  local control_file
  local action

  control_file="$(control_file_for "$mount_name")"
  [[ -r "$control_file" ]] || return 1
  action="$(<"$control_file")"
  rm -f "$control_file"

  case "$action" in
    pause)
      log "Pause requested for $mount_name"
      stop_mount_supervisor "$mount_name"
      stop_one "$mount_name" || true
      write_mount_state "$mount_name" paused 0 0 ""
      ;;
    resume)
      log "Resume requested for $mount_name"
      if [[ -z "${SUPERVISOR_PIDS[$mount_name]:-}" ]]; then
        start_mount_supervisor "$mount_name"
      fi
      ;;
    restart | retry)
      restart_mount_supervisor "$mount_name"
      ;;
    *)
      log "Ignoring unknown control request '$action' for $mount_name"
      ;;
  esac

  return 0
}

shutdown_supervised() {
  local mount_name

  trap - INT TERM HUP
  log "Termination requested; stopping mount supervisors"

  for mount_name in "${MOUNTS[@]}"; do
    stop_mount_supervisor "$mount_name"
  done

  stop_all || true
  exit 0
}

start_all_daemon() {
  ensure_requirements_for_start
  ensure_directories

  local mount_name
  local failures=0
  for mount_name in "${MOUNTS[@]}"; do
    if ! start_one_daemon "$mount_name"; then
      log "Failed to start $mount_name"
      failures=$((failures + 1))
      if is_true "$ROLLBACK_ON_START_FAILURE"; then
        log "Rolling back already-started mounts"
        stop_started_mounts || true
        return 1
      fi
    fi
  done

  if ((failures > 0)); then
    log "$failures configured mount(s) failed; successfully started mounts remain active"
    return 1
  fi

  log "All configured mounts are started"
}

stop_all() {
  require_command mountpoint
  ensure_directories

  local index
  local mount_name
  local failures=0

  for ((index = ${#MOUNTS[@]} - 1; index >= 0; index--)); do
    mount_name="${MOUNTS[$index]}"
    stop_one "$mount_name" || failures=$((failures + 1))
    write_mount_state "$mount_name" stopped 0 0 ""
  done

  ((failures == 0))
}

stop_started_mounts() {
  require_command mountpoint
  ensure_directories

  local index
  local mount_name
  local failures=0

  for ((index = ${#STARTED_MOUNTS[@]} - 1; index >= 0; index--)); do
    mount_name="${STARTED_MOUNTS[$index]}"
    stop_one "$mount_name" || failures=$((failures + 1))
    write_mount_state "$mount_name" stopped 0 0 ""
  done

  ((failures == 0))
}

status_all() {
  require_command mountpoint
  ensure_directories

  local mount_name
  local mount_point
  local pid_file
  local pid_status
  local state_status
  local next_retry
  local last_error
  local state_details

  for mount_name in "${MOUNTS[@]}"; do
    mount_point="$(mount_point_for "$mount_name")"
    pid_file="$(pid_file_for "$mount_name")"
    pid_status=""

    if [[ -f "$pid_file" ]]; then
      pid_status=" pid=$(<"$pid_file")"
    fi

    state_status="$(normalized_mount_status "$mount_name")"

    if [[ "$state_status" == "mounted" ]]; then
      printf '%-28s mounted     %s%s\n' "$mount_name" "$mount_point" "$pid_status"
    else
      next_retry="$(read_mount_state_field "$mount_name" next_retry 2>/dev/null || true)"
      last_error="$(read_mount_state_field "$mount_name" last_error 2>/dev/null || true)"
      state_details=""

      case "$state_status" in
        starting | retrying | failed | stopped | paused | pausing) ;;
        *) state_status="not mounted" ;;
      esac

      if [[ "$state_status" =~ ^(retrying|failed)$ && "$next_retry" =~ ^[1-9][0-9]*$ ]]; then
        state_details=" next-retry=$(date -d "@$next_retry" '+%Y-%m-%d %H:%M:%S')"
      fi
      [[ -z "$last_error" ]] || state_details="$state_details error=$last_error"

      printf '%-28s %-12s %s%s%s\n' "$mount_name" "$state_status" "$mount_point" "$pid_status" "$state_details"
    fi
  done
}

status_json() {
  require_command mountpoint
  ensure_directories

  local mount_name
  local mount_point
  local log_file
  local state_status
  local failures
  local next_retry
  local last_error
  local mounted
  local paused
  local separator=""

  printf '{'
  printf '"version":%s,' "$(json_quote "$VERSION")"
  printf '"mode":%s,' "$(json_quote "$MODE")"
  printf '"config_file":%s,' "$(json_quote "${CONFIG_FILE:-}")"
  printf '"log_dir":%s,' "$(json_quote "$LOG_DIR")"
  printf '"state_dir":%s,' "$(json_quote "$STATE_DIR")"
  printf '"persistent_state_dir":%s,' "$(json_quote "$PERSISTENT_STATE_DIR")"
  printf '"mounts":['

  for mount_name in "${MOUNTS[@]}"; do
    mount_point="$(mount_point_for "$mount_name")"
    log_file="$(log_file_for "$mount_name")"
    mounted=false
    mountpoint -q "$mount_point" && mounted=true
    state_status="$(normalized_mount_status "$mount_name" "$mounted")"
    failures="$(read_mount_state_field "$mount_name" failures 2>/dev/null || true)"
    next_retry="$(read_mount_state_field "$mount_name" next_retry 2>/dev/null || true)"
    last_error="$(read_mount_state_field "$mount_name" last_error 2>/dev/null || true)"
    [[ "$failures" =~ ^[0-9]+$ ]] || failures=0
    [[ "$next_retry" =~ ^[0-9]+$ ]] || next_retry=0

    paused=false
    mount_is_paused "$mount_name" && paused=true

    printf '%s{' "$separator"
    printf '"name":%s,' "$(json_quote "$mount_name")"
    printf '"status":%s,' "$(json_quote "$state_status")"
    printf '"mounted":%s,' "$mounted"
    printf '"paused":%s,' "$paused"
    printf '"mount_point":%s,' "$(json_quote "$mount_point")"
    printf '"log_file":%s,' "$(json_quote "$log_file")"
    printf '"failures":%s,' "$failures"
    printf '"next_retry":%s,' "$next_retry"
    printf '"last_error":%s' "$(json_quote "$last_error")"
    printf '}'
    separator=,
  done

  printf ']}\n'
}

run_supervised() {
  local mount_name
  local supervisor_pid
  local restart_at
  local now

  ensure_requirements_for_start
  ensure_directories
  trap shutdown_supervised INT TERM HUP

  for mount_name in "${MOUNTS[@]}"; do
    rm -f "$(control_file_for "$mount_name")"
    if mount_is_paused "$mount_name"; then
      write_mount_state "$mount_name" paused 0 0 ""
      log "$mount_name is paused; not starting its supervisor"
    else
      start_mount_supervisor "$mount_name"
    fi
  done
  log "All configured mounts have independent supervisors"

  while true; do
    sleep "$HEALTH_CHECK_INTERVAL_SECONDS"
    now="$(date +%s)"

    for mount_name in "${MOUNTS[@]}"; do
      if process_mount_control "$mount_name"; then
        continue
      fi

      if mount_is_paused "$mount_name"; then
        if [[ -n "${SUPERVISOR_PIDS[$mount_name]:-}" ]]; then
          stop_mount_supervisor "$mount_name"
          stop_one "$mount_name" || true
        fi
        write_mount_state "$mount_name" paused 0 0 ""
        continue
      fi

      supervisor_pid="${SUPERVISOR_PIDS[$mount_name]:-}"
      if [[ -n "$supervisor_pid" ]] && kill -0 "$supervisor_pid" >/dev/null 2>&1; then
        continue
      fi

      restart_at="${SUPERVISOR_RESTART_AT[$mount_name]:-}"
      if [[ -z "$restart_at" ]]; then
        [[ -z "$supervisor_pid" ]] || wait "$supervisor_pid" 2>/dev/null || true
        restart_at=$((now + SUPERVISOR_RESTART_DELAY_SECONDS))
        SUPERVISOR_RESTART_AT[$mount_name]="$restart_at"
        write_mount_state "$mount_name" failed 0 "$restart_at" "mount supervisor exited unexpectedly"
        log "Supervisor for $mount_name exited unexpectedly; restarting it in ${SUPERVISOR_RESTART_DELAY_SECONDS}s"
      elif ((now >= restart_at)); then
        start_mount_supervisor "$mount_name"
      fi
    done
  done
}

print_config() {
  printf 'APP_NAME=%s\n' "$APP_NAME"
  printf 'VERSION=%s\n' "$VERSION"
  printf 'CONFIG_FILE=%s\n' "${CONFIG_FILE:-<none>}"
  printf 'MODE=%s\n' "$MODE"
  printf 'ROOT_DIR_PATH=%s\n' "$ROOT_DIR_PATH"
  printf 'LOG_DIR=%s\n' "$LOG_DIR"
  printf 'STATE_DIR=%s\n' "$STATE_DIR"
  printf 'PERSISTENT_STATE_DIR=%s\n' "$PERSISTENT_STATE_DIR"
  printf 'CONNECTIVITY_CHECK=%s\n' "$CONNECTIVITY_CHECK"
  printf 'REQUIRE_EMPTY_MOUNTPOINT=%s\n' "$REQUIRE_EMPTY_MOUNTPOINT"
  printf 'ROLLBACK_ON_START_FAILURE=%s\n' "$ROLLBACK_ON_START_FAILURE"
  printf 'HEALTH_CHECK_INTERVAL_SECONDS=%s\n' "$HEALTH_CHECK_INTERVAL_SECONDS"
  printf 'RETRY_DELAYS_SECONDS=%s\n' "${RETRY_DELAYS_SECONDS[*]}"
  printf 'RETRY_RESET_SECONDS=%s\n' "$RETRY_RESET_SECONDS"
  printf 'MOUNTS=%s\n' "${MOUNTS[*]:-}"
}

doctor_check() {
  local label="$1"
  local command="$2"

  if command -v "$command" >/dev/null 2>&1; then
    printf 'ok   %s: %s\n' "$label" "$(command -v "$command")"
    return 0
  fi

  printf 'fail %s: missing %s\n' "$label" "$command"
  return 1
}

doctor() {
  local failures=0
  local mount_name
  local mount_point
  local remote

  print_config
  printf '\nChecks:\n'

  doctor_check "rclone" rclone || failures=$((failures + 1))
  doctor_check "mountpoint" mountpoint || failures=$((failures + 1))
  doctor_check "timeout" timeout || failures=$((failures + 1))

  if command -v fusermount3 >/dev/null 2>&1 || command -v fusermount >/dev/null 2>&1 || command -v umount >/dev/null 2>&1; then
    printf 'ok   unmount tool available\n'
  else
    printf 'fail no unmount tool found: fusermount3, fusermount, or umount\n'
    failures=$((failures + 1))
  fi

  if ((${#MOUNTS[@]} == 0)); then
    printf 'fail config: no mounts configured\n'
    failures=$((failures + 1))
  fi

  ensure_directories

  if [[ -w "$ROOT_DIR_PATH" ]]; then
    printf 'ok   root dir writable: %s\n' "$ROOT_DIR_PATH"
  else
    printf 'fail root dir not writable: %s\n' "$ROOT_DIR_PATH"
    failures=$((failures + 1))
  fi
  if [[ -w "$LOG_DIR" ]]; then
    printf 'ok   log dir writable: %s\n' "$LOG_DIR"
  else
    printf 'fail log dir not writable: %s\n' "$LOG_DIR"
    failures=$((failures + 1))
  fi
  if [[ -w "$STATE_DIR" ]]; then
    printf 'ok   state dir writable: %s\n' "$STATE_DIR"
  else
    printf 'fail state dir not writable: %s\n' "$STATE_DIR"
    failures=$((failures + 1))
  fi

  for mount_name in "${MOUNTS[@]}"; do
    mount_point="$(mount_point_for "$mount_name")"
    remote="${REMOTES[$mount_name]:-}"

    [[ -n "$remote" ]] || {
      printf 'fail %s: missing remote\n' "$mount_name"
      failures=$((failures + 1))
      continue
    }

    printf 'ok   %s remote: %s\n' "$mount_name" "$remote"
    mkdir -p "$mount_point"
    if [[ -w "$mount_point" ]]; then
      printf 'ok   %s mount point writable: %s\n' "$mount_name" "$mount_point"
    else
      printf 'fail %s mount point not writable: %s\n' "$mount_name" "$mount_point"
      failures=$((failures + 1))
    fi
  done

  if [[ "$MODE" == "system" && " ${DEFAULT_OPTIONS[*]} " == *" --allow-other "* ]]; then
    if [[ -r /etc/fuse.conf ]] && grep -Eq '^[[:space:]]*user_allow_other[[:space:]]*$' /etc/fuse.conf; then
      printf 'ok   /etc/fuse.conf allows --allow-other\n'
    else
      printf 'fail --allow-other requires user_allow_other in /etc/fuse.conf\n'
      failures=$((failures + 1))
    fi
  fi

  if ((failures > 0)); then
    return 1
  fi
}

main() {
  local command="${1:-help}"
  local subcommand="${2:-}"
  local mount_name="${3:-}"

  case "$command" in
    help | --help | -h)
      usage
      ;;
    start)
      load_config
      validate_config
      start_all_daemon
      ;;
    stop)
      load_config
      validate_config
      stop_all
      ;;
    restart)
      load_config
      validate_config
      stop_all
      start_all_daemon
      ;;
    status)
      load_config
      validate_config
      case "$subcommand" in
        "") status_all ;;
        --json) status_json ;;
        *) die "Unsupported status option: $subcommand" ;;
      esac
      ;;
    mount)
      [[ -n "$subcommand" && -n "$mount_name" ]] || die "Usage: $APP_NAME mount ACTION NAME"
      (($# == 3)) || die "Usage: $APP_NAME mount ACTION NAME"
      load_config
      validate_config
      request_mount_control "$subcommand" "$mount_name"
      ;;
    run)
      load_config
      validate_config
      run_supervised
      ;;
    doctor)
      load_config
      doctor
      ;;
    print-config)
      load_config
      print_config
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
